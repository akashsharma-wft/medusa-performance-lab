# These four IDs are unique to whoever seeded the database — copy this file to
# .env.k6 and fill it in with the output of:
#   docker compose run --rm app1 sh -c "cd /app/apps/backend && npx medusa exec ./src/scripts/print-test-env.ts"
# Don't reuse another environment's values; they point at rows that don't
# exist in your database.
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_replace_me
MEDUSA_REGION_ID=reg_replace_me
MEDUSA_SALES_CHANNEL_ID=sc_replace_me
LOW_STOCK_VARIANT_ID=variant_replace_me
LOW_STOCK_QTY=5
