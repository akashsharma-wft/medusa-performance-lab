{
  "title": "Medusa Checkout Performance Lab",
  "uid": "checkout-lab",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Postgres active connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres commits/sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[1m])", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis ops/sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "commands" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container CPU usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=~\"mpl-.*\"}[1m])", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container memory usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "container_memory_usage_bytes{name=~\"mpl-.*\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres lock waits",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "pg_locks_count", "legendFormat": "{{mode}}" }
      ]
    }
  ]
}
