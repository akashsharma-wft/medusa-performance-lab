{
  "name": "Medusa performance lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  // Ask for the biggest box available. The whole point of moving off the
  // laptop is having enough cores to give the load generator, the database
  // and the app tier budgets that do not overlap.
  "hostRequirements": { "cpus": 8, "memory": "16gb", "storage": "32gb" },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker", "GitHub.copilot"]
    }
  }
}
